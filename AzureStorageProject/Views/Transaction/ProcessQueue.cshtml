@{
    ViewData["Title"] = "Process Transaction Queue - ABC Retail";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">📬 Transaction Queue (via Azure Function)</h2>
                            <p class="text-muted mb-0">Reads and removes pending messages from the "transactionqueue"</p>
                        </div>
                        <a asp-action="ProcessQueue" class="btn btn-outline-primary rounded-pill">
                            <i class="bi bi-arrow-repeat"></i> Check Again
                        </a>
                    </div>

                    <div class="alert @(ViewBag.Success == true ? "alert-success" : "alert-warning") rounded-3">
                        <i class="bi @(ViewBag.Success == true ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                        @ViewBag.Message
                    </div>

                    @if (ViewBag.RawResponse != null)
                    {
                        <div class="card bg-light border-0 rounded-3 mt-3">
                            <div class="card-body">
                                <h6 class="text-muted mb-2">Raw function response</h6>
                                <pre class="mb-0 small" style="white-space: pre-wrap;">@ViewBag.RawResponse</pre>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-center mt-4">
                        <a asp-action="Create" class="btn btn-func btn-lg rounded-pill px-5">
                            <i class="bi bi-plus-circle"></i> Record New Transaction
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .btn-func {
            background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
            border: none;
            color: #212529;
            font-weight: 600;
        }

            .btn-func:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(247, 151, 30, 0.4);
                color: #212529;
            }
    </style>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
