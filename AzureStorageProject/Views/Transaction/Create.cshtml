@model AzureStorageProject.Models.TransactionViewModel

@{
    ViewData["Title"] = "Record Transaction - ABC Retail";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-func text-white rounded-top-4 p-4">
                    <h3 class="mb-0 fw-bold">⚡ Record Transaction (Azure Functions)</h3>
                    <p class="mb-0 opacity-75">Calls four Azure Functions: Table, Blob, Queue and Files</p>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info rounded-3 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Submitting this form calls four separate Azure Functions in sequence — one each
                        for Table Storage, Blob Storage, Queue Storage and Azure Files — instead of writing
                        to storage directly from this web app.
                    </div>

                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="OrderId" class="form-label fw-semibold">Order ID</label>
                            <input asp-for="OrderId" class="form-control form-control-lg rounded-3" placeholder="e.g. ORD-20260915-ABCD1234" />
                            <span asp-validation-for="OrderId" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Use the Order Reference from a previously placed order, or any identifier.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label fw-semibold">Customer Name</label>
                            <input asp-for="CustomerName" class="form-control form-control-lg rounded-3" placeholder="Enter customer name" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProductId" class="form-label fw-semibold">Product ID</label>
                            <input asp-for="ProductId" class="form-control form-control-lg rounded-3" placeholder="Enter Product Code" />
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                            <input asp-for="Quantity" class="form-control form-control-lg rounded-3" type="number" min="1" value="1" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Receipt" class="form-label fw-semibold">Receipt / Invoice (optional)</label>
                            <input asp-for="Receipt" class="form-control form-control-lg rounded-3" type="file" />
                            <small class="text-muted d-block mt-1">If attached, this file is written to Blob Storage via the Blob function.</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-func btn-lg rounded-pill px-5">
                                <i class="bi bi-lightning-charge"></i> Run Functions
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-gradient-func {
            background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
        }

        .btn-func {
            background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
            border: none;
            color: #212529;
            font-weight: 600;
        }

            .btn-func:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(247, 151, 30, 0.4);
                color: #212529;
            }

        .form-control {
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #f7971e;
                box-shadow: 0 0 0 0.2rem rgba(247, 151, 30, 0.25);
            }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
