<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AzureStorageProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        .navbar-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            box-shadow: 0 4px 20px rgba(102, 126, 234, 0.3);
            padding: 0.75rem 0;
        }

        .navbar-brand-custom {
            font-weight: 700;
            font-size: 1.75rem;
            letter-spacing: -0.5px;
            color: #ffffff;
            transition: transform 0.3s ease;
        }

            .navbar-brand-custom:hover {
                transform: scale(1.05);
                color: #ffffff;
            }

            .navbar-brand-custom i {
                margin-right: 0.5rem;
            }

        .nav-link-custom {
            color: rgba(255, 255, 255, 0.85);
            border-radius: 50px;
            padding: 0.5rem 1.25rem;
            transition: all 0.3s ease;
            font-weight: 500;
            font-size: 0.95rem;
            text-decoration: none;
        }

            .nav-link-custom:hover {
                color: #ffffff;
                background: rgba(255, 255, 255, 0.15);
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            }

            .nav-link-custom i {
                margin-right: 0.5rem;
                font-size: 1.1rem;
            }

            .nav-link-custom.active {
                color: #ffffff;
                background: rgba(255, 255, 255, 0.2);
            }

        .navbar-toggler-custom {
            border-color: rgba(255, 255, 255, 0.5);
            padding: 0.5rem 0.75rem;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 4px;
        }

            .navbar-toggler-custom:hover {
                background: rgba(255, 255, 255, 0.1);
            }

            .navbar-toggler-custom .navbar-toggler-icon {
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.9)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
                display: inline-block;
                width: 1.5rem;
                height: 1.5rem;
                vertical-align: middle;
                background-repeat: no-repeat;
                background-position: center;
                background-size: 100%;
            }

        .footer-custom {
            background: linear-gradient(135deg, #2d3436 0%, #1a1a2e 100%);
            color: rgba(255, 255, 255, 0.7);
            padding: 1.5rem 0;
            margin-top: auto;
            border-top: 3px solid #667eea;
        }

            .footer-custom a {
                color: rgba(255, 255, 255, 0.7);
                text-decoration: none;
                transition: color 0.3s ease;
            }

                .footer-custom a:hover {
                    color: #ffffff;
                }

        .main-content {
            min-height: calc(100vh - 200px);
        }

        @@media (max-width: 992px) {
            .navbar-brand-custom {
                font-size: 1.4rem;
            }

            .nav-link-custom {
                padding: 0.5rem 1rem;
            }

            .navbar-nav {
                gap: 0.25rem;
                padding-top: 0.5rem;
            }
        }

        @@media (max-width: 576px) {
            .navbar-brand-custom {
                font-size: 1.2rem;
            }

            .nav-link-custom {
                font-size: 0.85rem;
                padding: 0.4rem 0.8rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container-fluid">
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-cloud-arrow-up-fill"></i> ABC Retail
                </a>
                <button class="navbar-toggler navbar-toggler-custom" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Customer" asp-action="Index">
                                <i class="bi bi-people"></i> Customers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Blob" asp-action="Index">
                                <i class="bi bi-images"></i> Gallery
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Order" asp-action="Create">
                                <i class="bi bi-cart-plus"></i> Place Order
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Order" asp-action="ProcessQueue">
                                <i class="bi bi-gear"></i> Process Queue
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Transaction" asp-action="Create">
                                <i class="bi bi-lightning-charge"></i> Transactions (Functions)
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <span class="fw-bold">&copy; 2026 ABC Retail</span>
                    <span class="mx-2 text-white-50">|</span>
                    <span class="text-white-50">Azure Storage Solution</span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="text-white-50">
                        <i class="bi bi-cloud-check text-primary me-1"></i>
                        Powered by Azure Cloud Services
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>