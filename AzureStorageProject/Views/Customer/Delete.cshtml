@model AzureStorageProject.Models.CustomerProfile

@{
    ViewData["Title"] = "Delete Customer - ABC Retail";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-danger text-white rounded-top-4 p-4">
                    <h3 class="mb-0 fw-bold">🗑️ Delete Customer</h3>
                    <p class="mb-0 opacity-75">Are you sure you want to delete this customer?</p>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-danger rounded-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        This action cannot be undone. All customer data will be permanently removed.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 fw-semibold">Customer ID</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary fs-6">@Model.RowKey</span></dd>

                        <dt class="col-sm-4 fw-semibold">Full Name</dt>
                        <dd class="col-sm-8 fs-5">@Model.Name</dd>

                        <dt class="col-sm-4 fw-semibold">Email Address</dt>
                        <dd class="col-sm-8"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                        <dt class="col-sm-4 fw-semibold">Phone Number</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="PartitionKey" />
                        <input type="hidden" asp-for="RowKey" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-gradient-danger {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        }

        .btn-danger {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            border: none;
            color: #333;
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(250, 112, 154, 0.4);
                color: #333;
            }

        .card {
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .badge {
            padding: 0.5rem 1rem;
            font-weight: 500;
        }
    </style>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}