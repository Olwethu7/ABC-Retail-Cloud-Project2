@{
    ViewData["Title"] = "Process Queue - ABC Retail";
    var messages = ViewBag.ProcessedMessages as List<string>;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-gradient">📋 Process Queue</h1>
            <p class="text-muted">View and process orders from the Azure Queue</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle"></i> Place New Order
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 text-center">
                    <h5 class="text-muted mb-2">Queue Status</h5>
                    <h2 class="fw-bold text-primary">
                        @ViewBag.MessageCount
                    </h2>
                    <p class="text-muted small mb-0">Messages in queue</p>
                    <hr />
                    <a asp-action="ProcessQueue" class="btn btn-outline-primary btn-sm rounded-pill">
                        <i class="bi bi-arrow-repeat"></i> Check Queue
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 fw-semibold">Processing Results</h5>
                        <span class="badge @(messages != null && messages.Any() ? "bg-success" : "bg-secondary") rounded-pill px-3 py-2">
                            @(messages != null && messages.Any() ? $"✅ {messages.Count} processed" : "⚠️ No messages")
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.Message))
                    {
                        <div class="alert @(messages != null && messages.Any() ? "alert-success" : "alert-info") rounded-3">
                            <i class="bi @(messages != null && messages.Any() ? "bi-check-circle-fill" : "bi-info-circle-fill") me-2"></i>
                            @ViewBag.Message
                        </div>
                    }

                    @if (messages != null && messages.Any())
                    {
                        <div class="list-group">
                            @foreach (var msg in messages)
                            {
                                <div class="list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 border-bottom">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <span>@msg</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                <p class="mb-0">No messages in the queue to process.</p>
                                <small>Place an order to see it appear here.</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3">
                <div class="card bg-light border-0 rounded-4">
                    <div class="card-body p-3 text-center">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Orders are processed from the Azure Queue. In production, this would be automated.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .text-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: #ffffff;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
                color: #ffffff;
            }

        .card {
            transition: transform 0.2s;
        }

            .card:hover {
                transform: translateY(-4px);
            }

        .list-group-item {
            transition: background 0.2s;
        }

            .list-group-item:hover {
                background: #f8f9fa;
            }

        .badge {
            font-weight: 500;
        }
    </style>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}